# Jev: leave empty to run in mock mode
TYPESAFE_API_KEY=
# JEV_MOCK=1           # force mock mode even with a key

# DRY_RUN=1            # log what would be written instead of writing to ClickUp/GitHub

PORT=3000

# ClickUp: Settings → Apps → API Token (starts with pk_)
CLICKUP_TOKEN=
# Open the demo list in ClickUp; the id is in the URL (…/li/<id>)
CLICKUP_LIST_ID=
# Optional: auto-detected from the token if empty
CLICKUP_TEAM_ID=
# Printed by `npm run setup`
CLICKUP_WEBHOOK_SECRET=
# Fallback if the webhook can't reach you: poll the list every N seconds (0 = off)
CLICKUP_POLL_SECONDS=0

# Your public URL for the webhook, e.g. from `ngrok http 3000`
PUBLIC_URL=

# GitHub: fine-grained token with Issues read/write on the demo repo
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=your-org/jev-demo-issues
